      "source_symbol": "ResolveExplainoRuntimeFractalType",
      "classification": "direct",
      "review_disposition": "accepted"
    },
    {
      "claim_id": "explaino_all.recurrence_or_field_model.0",
      "selector": "explaino_all",
      "description_field": "recurrence_or_field_model",
      "sentence_index": 0,
      "claim_text": "The composed branch evaluates a degree-four real-coefficient polynomial and its derivative, forms a Newton step, and can combine alternating coefficient sets, vortex rotation, a perpendicular ripple kick, tension and balance-field biases, adaptive damping, and an optional Phoenix memory term.",
      "source_file": "ui_app/src/fractal_sample_device.inl",
      "source_symbol": "FractalSample canonical ExplainO composed branch",
      "classification": "editorial_paraphrase",
      "review_disposition": "accepted"
    },
    {
      "claim_id": "explaino_all.state_order.0",
      "selector": "explaino_all",
      "description_field": "state_order",
      "sentence_index": 0,
      "claim_text": "With a neutral Phoenix coefficient the update depends on the current complex state; with a nonzero Phoenix coefficient it also uses the previous state and is second-order in the stored orbit state.",
      "source_file": "ui_app/src/fractal_sample_device.inl",
      "source_symbol": "FractalSample canonical ExplainO zPrev update",
      "classification": "derived",
      "review_disposition": "accepted"
    },
    {
      "claim_id": "explaino_all.termination_or_classification.0",
      "selector": "explaino_all",
      "description_field": "termination_or_classification",
      "sentence_index": 0,
      "claim_text": "The branch tests polynomial residual against epsilon, rescales states outside radius four, resets and stops on nonfinite state, and otherwise classifies an unconverged result at the best recorded iteration by snapping to the nearest available root.",
      "source_file": "ui_app/src/fractal_sample_device.inl",
      "source_symbol": "FractalSample canonical ExplainO termination",
      "classification": "editorial_paraphrase",
      "review_disposition": "accepted"
    },
    {
      "claim_id": "explaino_all.interpretation_notes.0",
      "selector": "explaino_all",
      "description_field": "interpretation_notes",
      "sentence_index": 0,
      "claim_text": "The selector names a configurable family composition, so serialized nonzero axes identify enabled recurrence terms but do not by themselves prove which term is visually dominant in a captured frame.",
      "source_file": "ui_app/src/fractal_sample_device.inl",
      "source_symbol": "FractalSample canonical ExplainO composed terms",
      "classification": "derived",
      "review_disposition": "accepted"
    },
