      "claim_id": "explaino_all.math_summary.0",
      "selector": "explaino_all",
      "description_field": "math_summary",
      "sentence_index": 0,
      "claim_text": "ExplainO All is the canonical public ExplainO selector: neutral registry axes resolve to the baseline ExplainO runtime, while any active registered axis keeps the canonical composed branch.",
