{
  "version": 1,
  "contract_id": "scoped_root_pattern_control_authority_repair",
  "feature_id": "scoped_root_pattern_control_authority_repair",
  "workflow_type": "viewer_first",
  "plan_path": "docs/notes/scoped_root_pattern_control_authority_repair_PHASED_PLAN.md",
  "allowed_mutation_scope": [
    "docs/contracts",
    "docs/notes",
    "HANDOFF_LOG.md",
    "artifacts",
    "ui",
    "ui_app/src",
    "ui_app/tests",
    "tests"
  ],
  "required_operator_inputs": [
    "repair dead or inert visible controls on explaino_magnet_root_well",
    "remove stale unscoped root animation targets from composite root-field lanes",
    "prove each visible base Magnet and scoped Dynamics Root Field control has independent runtime sensitivity",
    "preserve scoped Dynamics and Color Root Field owner-only action semantics"
  ],
  "forbidden_operator_prompts": [
    "add new fractal families",
    "return to SDF product work",
    "add graph editor UI",
    "restore Pattern B as normal UI",
    "use physical mouse automation",
    "hide controls instead of proving or classifying authority"
  ],
  "required_defaults": {
    "branch": "codex/scoped-root-pattern-control-authority-repair",
    "primary_test_lane": "explaino_magnet_root_well",
    "composite_root_field_lanes": [
      "explaino_root_sdf",
      "explaino_mandelbrot_root_trap",
      "explaino_magnet_root_well"
    ],
    "runtime_publish_required_before_viewer_visible_closeout": true,
    "published_runtime_proof_required_before_viewer_visible_closeout": true
  },
  "forbidden_defaults": {
    "legacy_unscoped_animation_targets_on_composite_lanes": "forbidden",
    "grouped_control_sensitivity_only": "forbidden",
    "silent_owner_scope_cross_mutation": "forbidden",
    "physical_mouse_automation": "forbidden"
  },
  "required_validation_commands": [
    "py -3.14 tools/viewer_host_validate_slice_contract.py --contract docs/contracts/scoped_root_pattern_control_authority_repair.contract.json --out-json artifacts/validation/scoped_root_pattern_control_authority_repair_contract.json",
    "py -3.14 tools/viewer_host_run_logged_command.py --label scoped_root_pattern_control_authority_repair_plan_sync --log artifacts/scoped_root_pattern_control_authority_repair/plan_sync.log -- py -3.14 tools/viewer_host_assert_phased_plan_sync.py",
    "py -3.14 tools/code_quality_audit.py --check-baseline --out artifacts/validation/scoped_root_pattern_control_authority_repair_code_quality.json",
    "ui_app/build_tests_vsdevcmd.cmd test_schema_binding > artifacts/scoped_root_pattern_control_authority_repair/native_schema_binding.log 2>&1",
    "ui_app/build_vsdevcmd.cmd > artifacts/scoped_root_pattern_control_authority_repair/runtime_publish.log 2>&1",
    "py -3.14 -m pytest tests/test_fractal_runtime_root_field_consumers.py::test_explaino_magnet_root_well_base_magnet_controls_are_visible_and_active -q --junitxml artifacts/pytest/scoped_root_pattern_control_authority_repair_runtime.junit.xml",
    "py -3.14 tools/viewer_host_validate_hostile_audit.py --plan docs/notes/scoped_root_pattern_control_authority_repair_PHASED_PLAN.md --out-json artifacts/validation/scoped_root_pattern_control_authority_repair_hostile_audit.json",
    "git diff --check > artifacts/scoped_root_pattern_control_authority_repair/diff_check.log 2>&1"
  ],
  "required_acceptance_assertions": [
    {
      "assertion_id": "contract_schema_valid",
      "description": "The control-authority repair contract validates successfully.",
      "evidence_kind": "validator_json",
      "artifact_path": "artifacts/validation/scoped_root_pattern_control_authority_repair_contract.json",
      "json_path": "checks.contract_schema_valid",
      "equals": true
    },
    {
      "assertion_id": "runtime_control_authority_green",
      "description": "Published no-mouse runtime proof passes for independent visible-control sensitivity on Magnet Root Well.",
      "evidence_kind": "pytest_junit_case",
      "artifact_path": "artifacts/pytest/scoped_root_pattern_control_authority_repair_runtime.junit.xml",
      "test_nodeid": "tests/test_fractal_runtime_root_field_consumers.py::test_explaino_magnet_root_well_base_magnet_controls_are_visible_and_active"
    },
    {
      "assertion_id": "hostile_audit_ok",
      "description": "Hostile audit is complete before closeout.",
      "evidence_kind": "validator_json",
      "artifact_path": "artifacts/validation/scoped_root_pattern_control_authority_repair_hostile_audit.json",
      "json_path": "ok",
      "equals": true
    }
  ]
