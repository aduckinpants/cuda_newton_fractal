    "py -3.14 tools/viewer_host_run_logged_command.py --label scoped_root_pattern_authority_hardening_plan_sync --log artifacts/scoped_root_pattern_authority_hardening/plan_sync.log -- py -3.14 tools/viewer_host_assert_phased_plan_sync.py",
